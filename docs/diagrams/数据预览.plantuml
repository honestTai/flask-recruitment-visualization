@startuml
actor User
participant "客户端" as Client
participant "Flask" as Server
participant "Job数据" as JobData
activate User
activate Client
User -> Client: 请求获取职位数据
Client -> Server: 发送获取职位数据请求
activate Server
Server -> JobData: 调用数据获取函数
activate JobData
JobData -> JobData: 检查参数合法性
alt 参数异常
    Server -> Client: 返回400错误，参数异常
    Client -> User: 显示参数异常提示
else
    JobData -> JobData: 从清洗后的数据中获取职位数据
    alt 数据为空
        Server -> Client: 返回空数据
        Client -> User: 显示无数据提示
    else
        JobData -> JobData: 根据分页信息筛选数据
        Server -> Client: 返回获取到的职位数据
        Client -> User: 显示职位数据列表
    end
end
deactivate JobData
deactivate Server
deactivate Client
deactivate User
@enduml
