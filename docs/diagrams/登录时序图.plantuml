@startuml
actor User
participant "客户端" as Client
participant "Flask" as Server
database DB
activate User
User -> Client: 提交登录请求
activate Client
Client -> Server: 发送登录请求
activate Server
Server -> DB: 查询用户信息
activate DB
alt 用户提交的参数不完整
    Server -> Client: 返回400错误，参数不能为空
    Client -> User: 显示参数不能为空的提示
else
    Server -> DB: 尝试连接数据库
    alt 数据库连接成功
        DB --> Server: 返回用户信息
        alt 用户存在且密码匹配
            Server -> Client: 返回登录成功消息
            Client -> User: 显示登录成功提示
        else 用户不存在或密码错误
            Server -> Client: 返回400错误，用户名或密码错误
            Client -> User: 显示用户名或密码错误的提示
        end
    else 数据库连接失败
        Server -> Client: 返回500错误，数据库连接失败
        Client -> User: 显示数据库连接失败的提示
    end
end
deactivate DB
deactivate Server
deactivate Client
deactivate Server
@enduml
